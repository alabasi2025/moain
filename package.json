{
  "name": "edaat-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "منصة إضاءات التعليمية — حصص مباشرة، تسجيلات محمية، واجبات، رسائل، ونظام مالي",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist --d1=edaat-db --r2=edaat-media --ip 0.0.0.0 --port 3000",
    "db:migrate:local": "wrangler d1 migrations apply edaat-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply edaat-db --remote",
    "db:seed": "node scripts/gen-seed.mjs && wrangler d1 execute edaat-db --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "deploy": "npm run build && wrangler pages deploy dist --project-name edaat-platform"
  },
  "dependencies": {
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@fontsource-variable/alexandria": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/node": "^26.6.3",
    "lucide-static": "^1.48.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
